<note><title>Erbsensuppe</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
<en-note><h2>Zutaten</h2><ul><li>500 g Mehl</li><li>1 Zwiebel</li><li>Salz, Pfeffer</li></ul><h2>Zubereitung</h2><div>Alles vorbereiten, langsam garen, abschmecken.</div></en-note>]]></content><created>20240613T075749Z</created><updated>20240722T075749Z</updated><tag>rezept</tag><tag>kochen</tag><note-attributes><author>Beispiel</author></note-attributes></note>
<note><title>Käsespätzle</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
<en-note><h2>Zutaten</h2><ul><li>500 g Linsen</li><li>1 Zwiebel</li><li>Salz, Pfeffer</li></ul><h2>Zubereitung</h2><div>Alles vorbereiten, langsam garen, abschmecken.</div></en-note>]]></content><created>20210301T104442Z</created><updated>20210320T104442Z</updated><tag>rezept</tag><tag>kochen</tag><note-attributes><author>Beispiel</author></note-attributes></note>
