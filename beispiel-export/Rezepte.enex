<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE en-export SYSTEM "http://xml.evernote.com/pub/evernote-export4.dtd">
<en-export export-date="20261028T060000Z" application="Evernote" version="10.0">
<note><title>Apfelkuchen</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
<en-note><h2>Zutaten</h2><ul><li>250 g Mehl</li><li>125 g Butter</li><li>100 g Zucker</li><li>1 Ei</li><li>1 Päckchen Backpulver</li><li>1 kg säuerliche Äpfel</li></ul><h2>Zubereitung</h2><div>Teig kneten, in die Springform drücken, Äpfel in Spalten darauf legen. Bei 180 °C etwa 45 Minuten backen.</div></en-note>]]></content><created>20250903T133000Z</created><updated>20250903T133000Z</updated><tag>backen</tag><tag>klassiker</tag><note-attributes><author>Beispiel</author></note-attributes></note>
<note><title>Linsensuppe</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
<en-note><div>Für 4 Personen. Mit Würstchen oder ohne.</div><ul><li>300 g Tellerlinsen</li><li>1 Bund Suppengrün</li><li>2 Kartoffeln</li><li>1 EL Essig zum Schluss</li></ul><div>Alles 40 Minuten köcheln lassen, mit Salz, Pfeffer und Essig abschmecken.</div></en-note>]]></content><created>20260218T111500Z</created><updated>20260218T111500Z</updated><tag>kochen</tag><note-attributes><author>Beispiel</author></note-attributes></note>
<note><title>Kartoffelsalat</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
<en-note><div>Festkochende Kartoffeln, warme Brühe, Zwiebeln, Essig, Öl. Am besten über Nacht ziehen lassen.</div></en-note>]]></content><created>20250621T154800Z</created><updated>20250621T154800Z</updated><tag>kochen</tag><tag>klassiker</tag><note-attributes><author>Beispiel</author></note-attributes></note>
</en-export>
